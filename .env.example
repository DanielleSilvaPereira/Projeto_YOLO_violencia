# --- contrato com o backend (docs/contrato-ia.md) ---
# token que o backend manda em POST /analisar (vazio = sem autenticação)
IA_TOKEN=
# token que este serviço manda no callback (tem que ser igual ao do backend)
IA_CALLBACK_TOKEN=troque-isto

# --- modelo ---
MODELO_PESOS=pesos/melhor.pt
VERSAO_MODELO=yolov9c-cls-xdviolence-v1
# DISPOSITIVO=0            # GPU 0; "cpu" força CPU; vazio = automático
IMGSZ=224
FPS_AMOSTRAGEM=4

# --- regras de decisão ---
LIMIAR_FRAME=0.5
LIMIAR_ALERTA_ALTO=70
LIMIAR_ANOMALIA=40
JANELA_SUAVIZACAO_S=1.0
DURACAO_MIN_SEGMENTO_S=1.0
UNIAO_MAX_S=1.0
TOPO_S=2.0
